<template name="config-menu__cheats">
    <head>
    </head>
    <body>
        <form class="config__form" id="conf-cheats__form">
            <div class="config__hz-wrapper">
                <!-- Options -->
                <div class="config__wrapper" data-event-mouseout="set_cur_config_index(-1)" style="max-height: 100%; overflow-y: auto;">

                    <div class="config-option" data-event-mouseover="set_cur_config_index(0)">
                        <label class="config-option__title">Invulnerability</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(0)"
                                name="cheat_invulnerable"
                                data-checked="cheat_invulnerable"
                                value="Off"
                                id="cheat_invulnerable_off"
                                style="nav-up: #tab_cheats; nav-down: #cheat_all_weapons_off"
                            />
                            <label class="config-option__tab-label" for="cheat_invulnerable_off">Off</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(0)"
                                name="cheat_invulnerable"
                                data-checked="cheat_invulnerable"
                                value="On"
                                id="cheat_invulnerable_on"
                                style="nav-up: #tab_cheats; nav-down: #cheat_all_weapons_on"
                            />
                            <label class="config-option__tab-label" for="cheat_invulnerable_on">On</label>
                        </div>
                    </div>

                    <div class="config-option" data-event-mouseover="set_cur_config_index(1)">
                        <label class="config-option__title">All Weapons</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(1)"
                                name="cheat_all_weapons"
                                data-checked="cheat_all_weapons"
                                value="Off"
                                id="cheat_all_weapons_off"
                                style="nav-up: #cheat_invulnerable_off; nav-down: #cheat_all_levels_off"
                            />
                            <label class="config-option__tab-label" for="cheat_all_weapons_off">Off</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(1)"
                                name="cheat_all_weapons"
                                data-checked="cheat_all_weapons"
                                value="On"
                                id="cheat_all_weapons_on"
                                style="nav-up: #cheat_invulnerable_on; nav-down: #cheat_all_levels_on"
                            />
                            <label class="config-option__tab-label" for="cheat_all_weapons_on">On</label>
                        </div>
                    </div>

                    <div class="config-option" data-event-mouseover="set_cur_config_index(2)">
                        <label class="config-option__title">All Levels</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(2)"
                                name="cheat_all_levels"
                                data-checked="cheat_all_levels"
                                value="Off"
                                id="cheat_all_levels_off"
                                style="nav-up: #cheat_all_weapons_off; nav-down: #cheat_infinite_ammo_off"
                            />
                            <label class="config-option__tab-label" for="cheat_all_levels_off">Off</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(2)"
                                name="cheat_all_levels"
                                data-checked="cheat_all_levels"
                                value="On"
                                id="cheat_all_levels_on"
                                style="nav-up: #cheat_all_weapons_on; nav-down: #cheat_infinite_ammo_on"
                            />
                            <label class="config-option__tab-label" for="cheat_all_levels_on">On</label>
                        </div>
                    </div>

                    <div class="config-option" data-event-mouseover="set_cur_config_index(3)">
                        <label class="config-option__title">Infinite Ammo</label>
                        <div class="config-option__list">
                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(3)"
                                name="cheat_infinite_ammo"
                                data-checked="cheat_infinite_ammo"
                                value="Off"
                                id="cheat_infinite_ammo_off"
                                style="nav-up: #cheat_all_levels_off; nav-down: #cheat_refill_health"
                            />
                            <label class="config-option__tab-label" for="cheat_infinite_ammo_off">Off</label>

                            <input
                                type="radio"
                                data-event-blur="set_cur_config_index(-1)"
                                data-event-focus="set_cur_config_index(3)"
                                name="cheat_infinite_ammo"
                                data-checked="cheat_infinite_ammo"
                                value="On"
                                id="cheat_infinite_ammo_on"
                                style="nav-up: #cheat_all_levels_on; nav-down: #cheat_refill_health"
                            />
                            <label class="config-option__tab-label" for="cheat_infinite_ammo_on">On</label>
                        </div>
                    </div>

                    <div class="config-debug-option">
                        <label class="config-debug-option__label"><div>Refill Health</div></label>
                        <div class="config-debug__option-split">
                            <div class="config-debug__option-controls"></div>
                            <div class="config-debug__option-trigger">
                                <button class="icon-button icon-button--success" onclick="cheat_refill_health" id="cheat_refill_health"
                                        data-event-focus="set_cur_config_index(4)" data-event-mouseover="set_cur_config_index(4)"
                                        style="nav-up: #cheat_infinite_ammo_off; nav-down: #cheat_warp_select">
                                    <svg src="icons/Arrow.svg" />
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="config-debug-option">
                        <label class="config-debug-option__label"><div>Level Select</div></label>
                        <div class="config-debug__option-split">
                            <div class="config-debug__option-controls">
                                <div class="config-debug__select-wrapper">
                                    <select data-value="cheat_warp_level" id="cheat_warp_select"
                                            data-event-focus="set_cur_config_index(5)" data-event-mouseover="set_cur_config_index(5)"
                                            style="nav-up: #cheat_refill_health; nav-down: #cheat_exit_select">
                                        <option data-for="level, i : cheat_level_names" data-attr-value="i">{{level}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="config-debug__option-trigger">
                                <button class="icon-button icon-button--success" onclick="cheat_warp" id="cheat_warp_button"
                                        data-event-focus="set_cur_config_index(5)"
                                        style="nav-up: #cheat_refill_health; nav-down: #cheat_take_exit_button">
                                    <svg src="icons/Arrow.svg" />
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="config-debug-option">
                        <label class="config-debug-option__label"><div>Skip Ahead</div></label>
                        <div class="config-debug__option-split">
                            <div class="config-debug__option-controls">
                                <div class="config-debug__select-wrapper">
                                    <select data-value="cheat_exit_index" id="cheat_exit_select"
                                            data-event-focus="set_cur_config_index(6)" data-event-mouseover="set_cur_config_index(6)"
                                            style="nav-up: #cheat_warp_select">
                                        <option data-for="exit, i : cheat_exit_labels" data-attr-value="i">{{exit}}</option>
                                    </select>
                                </div>
                            </div>
                            <div class="config-debug__option-trigger">
                                <button class="icon-button icon-button--success" onclick="cheat_take_exit" id="cheat_take_exit_button"
                                        data-event-focus="set_cur_config_index(6)"
                                        style="nav-up: #cheat_warp_button">
                                    <svg src="icons/Arrow.svg" />
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="config-option">
                        <label class="config-option__title">{{cheat_status}}</label>
                    </div>
                </div>

                <!-- Descriptions -->
                <div class="config__wrapper">
                    <p data-if="cur_config_index == 0">
                        Enemies can't hurt you (the game's own invulnerability cheat).
                    </p>
                    <p data-if="cur_config_index == 1">
                        Gives you every weapon (the game's own cheat). Ammo still runs down unless Infinite Ammo is on.
                    </p>
                    <p data-if="cur_config_index == 2">
                        Opens every planet on the ship's map (the game's own cheat).
                    </p>
                    <p data-if="cur_config_index == 3">
                        Keeps every weapon you carry at full ammo.
                    </p>
                    <p data-if="cur_config_index == 4">
                        Restores full health now.
                    </p>
                    <p data-if="cur_config_index == 5">
                        Jumps straight to any level.
                        <br />
                        <br />
                        <b>Jumping into story scenes out of order can show a black screen, skip a fight's set-up or leave a boss missing</b>, because the game expects you to arrive the normal way. Skip Ahead is the safe way through.
                    </p>
                    <p data-if="cur_config_index == 6">
                        Leaves the current level through one of its exits, the same way walking into it would. Exits are listed by how far away they are now.
                    </p>
                </div>
            </div>
        </form>
    </body>
</template>
