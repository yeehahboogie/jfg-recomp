# Source this to use the project-local toolchain in .toolchain/ (unpacked Ubuntu packages, no root):
#   clang/lld 18 and SDL2 development files. If the system packages get installed, this is unneeded.
JFG_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [ -x "$JFG_ROOT/.toolchain/root/usr/lib/llvm-18/bin/clang" ]; then
  export PATH="$JFG_ROOT/.toolchain/root/usr/lib/llvm-18/bin:$PATH"
  export SDL2_DIR="$JFG_ROOT/.toolchain/root/usr/lib/x86_64-linux-gnu/cmake/SDL2"
  # Debian keeps SDL2's real config header under the multiarch include directory
  export CPATH="$JFG_ROOT/.toolchain/root/usr/include/x86_64-linux-gnu${CPATH:+:$CPATH}"
  export CMAKE_PREFIX_PATH="$JFG_ROOT/.toolchain/root/usr${CMAKE_PREFIX_PATH:+:$CMAKE_PREFIX_PATH}"
fi
