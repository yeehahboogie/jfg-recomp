+            dst.y = readDKR16(state, src + 2);
+            dst.z = readDKR16(state, src + 4);
+            dst.flag = 0;
+            dst.s = 0;
+            dst.t = 0;
+            dst.color.r = readDKR8(state, src + 6);
+            dst.color.g = readDKR8(state, src + 7);
+            dst.color.b = readDKR8(state, src + 8);
