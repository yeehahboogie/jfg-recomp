     void RSP::reset() {
+        dkr.slots.fill(hlslpp::float4x4::identity());
+        dkr.slotAbsolute.fill(false);
+        dkr.activeSlot = 0;
+        dkr.billboard = false;
+        dkr.vertexIndex = 0;
+        dkr.mtxOffset = 0;
