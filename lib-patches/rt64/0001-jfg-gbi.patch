+            const bool scissorIsScreen = ((right - left) >= fbWidth * 0.95f) && ((bottom - top) >= fbWidth * 0.75f * 0.95f);
+            if ((right > left) && (bottom > top) && framesThe4x3 && scissorIsScreen &&
+                (minX <= left + marginX) && (maxX >= right - marginX) && (minY <= top + marginY) && (maxY >= bottom - marginY))
+            {
+                static const bool debugPillarbox = getenv("JFG_DEBUG_PILLARBOX") != nullptr;
+                if (debugPillarbox) {
+                    fprintf(stderr, "[pillarbox] workload %llu: %u tris, bbox (%.0f,%.0f)-(%.0f,%.0f), area %.0f of screen %.0f (%.2f), st span %.0f x %.0f, colour %08X %s\n",
+                        (unsigned long long)state->workloadCounter, triCount, minX, minY, maxX, maxY, area,
+                        (right - left) * (bottom - top), area / ((right - left) * (bottom - top)), maxS - minS, maxT - minT, firstColor, uniformColor ? "uniform" : "varies");
+                }
+                state->fullscreen2DWorkload = state->workloadCounter;
+                state->fullscreen2DSeen = true;
+                state->fullscreen2DRect = screen;
+            }
+            else if ((right > left) && (bottom > top) && framesThe4x3 && !scissorIsScreen &&
+                (minX <= left + marginX) && (maxX >= right - marginX) && (minY <= top + marginY) && (maxY >= bottom - marginY))
+            {
+                // A layer filling one player's split-screen view (each view gets a fade layer every frame): show the
+                // frame at 4:3 like the original, rather than stretching only the views that touch a screen edge.
+                state->fullscreen2DWorkload = state->workloadCounter;
+                state->fullscreen2DSeen = true;
+                state->fullscreen2DRect = FixedRect(0, 0, int32_t(fbWidth * 4.0f), int32_t(fbWidth * 0.75f * 4.0f));
+            }
+        }
+    }
+
+    TransformGroup RSP::jfgTransformGroup(uint32_t physicalAddress, bool projection) const {
+        TransformGroup group;
+        const JfgFrameTable *table = state->jfgFrame;
+        const JfgMatrixIdentity *entry = ((table != nullptr) && table->enabled) ? table->find(physicalAddress) : nullptr;
+        if (entry == nullptr) {
+            group.matrixId = G_EX_ID_IGNORE;
+            return group;
+        }
+
+        auto mode = [entry](uint8_t skipBit) {
+            return (entry->skip & skipBit) ? uint8_t(G_EX_COMPONENT_SKIP) : uint8_t(G_EX_COMPONENT_INTERPOLATE);
+        };
+        group.matrixId = entry->id;
+        group.ordering = G_EX_ORDER_LINEAR;
+        group.positionInterpolation = mode(JFG_SKIP_POSITION);
+        group.rotationInterpolation = mode(JFG_SKIP_ROTATION);
+        group.scaleInterpolation = mode(JFG_SKIP_SCALE);
+        group.skewInterpolation = mode(JFG_SKIP_SCALE);
+        group.perspectiveInterpolation = projection ? mode(JFG_SKIP_SCALE) : uint8_t(G_EX_COMPONENT_AUTO);
+        group.vertexInterpolation = G_EX_COMPONENT_SKIP;
+        group.tileInterpolation = G_EX_COMPONENT_SKIP;
+        return group;
+    }
+
+    void RSP::setModelGroupDKR(uint32_t physicalAddress) {
+        TransformGroup &group = extended.modelMatrixIdStack[extended.modelMatrixIdStackSize - 1];
+        group = jfgTransformGroup(physicalAddress, false);
+        extended.modelMatrixIdStackChanged = true;
+        if (group.matrixId == G_EX_ID_IGNORE) {
+            jfgUnknown++;
+        }
+        else {
+            jfgTagged++;
+        }
+    }
+
+    // The identity model under an absolute matrix or a billboard isn't a world transform of its own: never pair it.
+    void RSP::setModelGroupIgnoreDKR() {
+        TransformGroup &group = extended.modelMatrixIdStack[extended.modelMatrixIdStackSize - 1];
+        group = TransformGroup();
+        group.matrixId = G_EX_ID_IGNORE;
+        extended.modelMatrixIdStackChanged = true;
+    }
+
+    // Slot 0 of Rare's matrix slots is the camera: load it as the view-projection so the renderer still
+    // knows the real projection.
+    void RSP::setViewProjDKR(const hlslpp::float4x4 &viewProj, uint32_t physicalAddress, bool interpolate) {
+        TransformGroup &group = extended.viewProjMatrixIdStack[extended.viewProjMatrixIdStackSize - 1];
+        // Jet Force Gemini cameras (slot 0) are matched by the identity the game's hooks gave their matrix. Absolute
+        // matrices and billboards (interpolate = false) also become projections here; until they're rebuilt as model
+        // transforms (interpolation plan 2) they're drawn as-is, so they can't be blended with a camera.
+        if (interpolate) {
+            group = jfgTransformGroup(physicalAddress, true);
+            if (group.matrixId == G_EX_ID_IGNORE) {
+                if (jfgCamerasUnknown++ == 0) {
+                    jfgFirstUnknownCamera = physicalAddress;
+                }
+            }
+            else {
+                jfgCamerasTagged++;
+            }
+        }
+        else {
+            group = TransformGroup();
+            group.matrixId = G_EX_ID_IGNORE;
+        }
+        extended.viewProjMatrixIdStackChanged = true;
+
+        hlslpp::float4x4 &viewMatrix = viewMatrixStack[projectionMatrixStackSize - 1];
+        hlslpp::float4x4 &projMatrix = projMatrixStack[projectionMatrixStackSize - 1];
+        viewProjMatrixStack[projectionMatrixStackSize - 1] = viewProj;
+        if (isMatrixViewProj(viewProj)) {
+            matrixDecomposeViewProj(viewProj, viewMatrix, projMatrix);
+        }
+        else {
+            projMatrix = viewProj;
+            viewMatrix = hlslpp::float4x4::identity();
+        }
+
+        projectionMatrixSegmentedAddressStack[projectionMatrixStackSize - 1] = physicalAddress;
+        projectionMatrixPhysicalAddressStack[projectionMatrixStackSize - 1] = physicalAddress;
+        projectionMatrixChanged = true;
+        projectionMatrixInversed = false;
+        modelViewProjChanged = true;
+    }
+
+    void RSP::applyMatrixSlotDKR() {
+        const uint32_t slot = dkr.activeSlot & 3;
+        if (dkr.slotAbsolute[slot]) {
+            // A complete transform: make it the projection with an identity model, rather than recovering a world
+            // matrix through the inverse of the camera's (which drops these draws).
+            setViewProjDKR(dkr.slots[slot], dkr.slotAddress[slot], false);
+            dkr.viewProjIsSlot0 = false;
+            modelMatrixStack[modelMatrixStackSize - 1] = hlslpp::float4x4::identity();
+            setModelGroupIgnoreDKR();
+        }
+        else {
+            if (!dkr.viewProjIsSlot0) {
+                setViewProjDKR(dkr.viewProj0, dkr.slotAddress[0]);
+                dkr.viewProjIsSlot0 = true;
+            }
+            modelMatrixStack[modelMatrixStackSize - 1] = dkr.slots[slot];
+            // Slot 0 is the camera with an identity model: the camera's projection group carries its motion.
+            if (slot == 0) {
+                setModelGroupIgnoreDKR();
+            }
+            else {
+                setModelGroupDKR(dkr.slotAddress[slot]);
+            }
+        }
+        modelViewProjChanged = true;
+    }
+
     Projection::Type RSP::getCurrentProjectionType() const {
         const hlslpp::float4x4 &projMatrix = projMatrixStack[projectionMatrixStackSize - 1];
         const bool perspProj = (projMatrix[3][3] == 0.0f) && (abs(projMatrix[1][1]) > 1e-6f);
