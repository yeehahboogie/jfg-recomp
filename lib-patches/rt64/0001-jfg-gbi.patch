+    // RDRAM holds native-endian 32-bit words, so bytes and halfwords at unaligned addresses are swizzled.
+    static int16_t readDKR16(State *state, uint32_t address) {
+        return *reinterpret_cast<const int16_t *>(state->fromRDRAM(address ^ 2));
+    }
+
+    static uint8_t readDKR8(State *state, uint32_t address) {
+        return *state->fromRDRAM(address ^ 3);
+    }
