@@ -380,6 +389,104 @@ namespace RT64 {
         vertexColorPDAddress = fromSegmentedMasked(address);
     }
 
+    // RDRAM holds native-endian 32-bit words, so bytes and halfwords at unaligned addresses are swizzled.
+    static int16_t readDKR16(State *state, uint32_t address) {
+        return *reinterpret_cast<const int16_t *>(state->fromRDRAM(address ^ 2));
+    }
+
+    static uint8_t readDKR8(State *state, uint32_t address) {
+        return *state->fromRDRAM(address ^ 3);
+    }
+
+    // Rare's DMA'd vertex: 10 bytes, s16 x, y, z then u8 r, g, b, a. No texture coordinates: those come
+    // with each triangle.
+    void RSP::setVertexDKR(uint32_t address, uint8_t vtxCount, uint32_t dstIndex) {
+        if ((dstIndex >= RSP_MAX_VERTICES) || ((dstIndex + vtxCount) > RSP_MAX_VERTICES)) {
+            assert(false && "Vertex indices are not valid. DL is possibly corrupted.");
+            return;
+        }
+
+        for (uint32_t i = 0; i < vtxCount; i++) {
+            const uint32_t src = address + i * 10;
+            Vertex &dst = vertices[dstIndex + i];
+            dst.x = readDKR16(state, src + 0);
+            dst.y = readDKR16(state, src + 2);
+            dst.z = readDKR16(state, src + 4);
+            dst.flag = 0;
+            dst.s = 0;
+            dst.t = 0;
+            dst.color.r = readDKR8(state, src + 6);
+            dst.color.g = readDKR8(state, src + 7);
+            dst.color.b = readDKR8(state, src + 8);
+            dst.color.a = readDKR8(state, src + 9);
+        }
+
+        setVertexCommon<true>(dstIndex, dstIndex + vtxCount);
+    }
+
+    // Rare's DMA'd triangle: 16 bytes, u8 flags, u8 v0, v1, v2, then s16 (s, t) for each corner.
+    // Flag 0x40 disables culling. Texture coordinates belong to the triangle, so each corner vertex is
+    // re-processed with them before the triangle is drawn.
+    void RSP::drawTrianglesDKR(uint32_t address, uint32_t triCount) {
+        const uint32_t cullBack = cullBothMask & ~cullFrontMask;
+        for (uint32_t i = 0; i < triCount; i++) {
+            const uint32_t src = address + i * 16;
+            const uint8_t flags = readDKR8(state, src + 0);
+            const uint32_t v[3] = { readDKR8(state, src + 1), readDKR8(state, src + 2), readDKR8(state, src + 3) };
+            if ((v[0] >= RSP_MAX_VERTICES) || (v[1] >= RSP_MAX_VERTICES) || (v[2] >= RSP_MAX_VERTICES)) {
+                assert(false && "Triangle indices are not valid. DL is possibly corrupted.");
+                continue;
+            }
+
+            const uint32_t wantCull = (flags & 0x40) ? 0 : cullBack;
+            if ((geometryModeStack[geometryModeStackSize - 1] & cullBothMask) != wantCull) {
+                modifyGeometryMode(~cullBothMask, wantCull);
+            }
+
+            for (uint32_t k = 0; k < 3; k++) {
+                vertices[v[k]].s = readDKR16(state, src + 4 + k * 4);
+                vertices[v[k]].t = readDKR16(state, src + 6 + k * 4);
+                setVertexCommon<true>(uint8_t(v[k]), uint8_t(v[k] + 1));
+            }
+
+            drawIndexedTri(v[0], v[1], v[2]);
+        }
+    }
+
+    // Slot 0 of Rare's matrix slots is the camera: load it as the view-projection so the renderer still
+    // knows the real projection.
+    void RSP::setViewProjDKR(const hlslpp::float4x4 &viewProj, uint32_t physicalAddress) {
+        hlslpp::float4x4 &viewMatrix = viewMatrixStack[projectionMatrixStackSize - 1];
+        hlslpp::float4x4 &projMatrix = projMatrixStack[projectionMatrixStackSize - 1];
+        viewProjMatrixStack[projectionMatrixStackSize - 1] = viewProj;
+        if (isMatrixViewProj(viewProj)) {
+            matrixDecomposeViewProj(viewProj, viewMatrix, projMatrix);
+        }
+        else {
+            projMatrix = viewProj;
+            viewMatrix = hlslpp::float4x4::identity();
+        }
+
+        projectionMatrixSegmentedAddressStack[projectionMatrixStackSize - 1] = physicalAddress;
+        projectionMatrixPhysicalAddressStack[projectionMatrixStackSize - 1] = physicalAddress;
+        projectionMatrixChanged = true;
+        projectionMatrixInversed = false;
+        modelViewProjChanged = true;
+    }
+
+    void RSP::applyMatrixSlotDKR() {
+        const uint32_t slot = dkr.activeSlot & 3;
+        if (dkr.slotAbsolute[slot]) {
+            modelViewProjMatrix = dkr.slots[slot];
+            modelViewProjInserted = true;
+            modelViewProjChanged = false;
+        }
+        else {
+            modelMatrixStack[modelMatrixStackSize - 1] = dkr.slots[slot];
+            modelViewProjChanged = true;
+        }
+    }
+
     Projection::Type RSP::getCurrentProjectionType() const {
         const hlslpp::float4x4 &projMatrix = projMatrixStack[projectionMatrixStackSize - 1];
         const bool perspProj = (projMatrix[3][3] == 0.0f) && (abs(projMatrix[1][1]) > 1e-6f);
