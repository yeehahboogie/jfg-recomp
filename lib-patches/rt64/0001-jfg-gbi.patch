@@ -0,0 +1,15 @@
+//
+// RT64
+//
+
+#pragma once
+
+#include "rt64_gbi.h"
+
+namespace RT64 {
+    // Rare's microcode for Diddy Kong Racing and Jet Force Gemini: F3D with matrices, vertices and
+    // triangles fetched by DMA, matrix slots, billboarding and counted display lists.
+    namespace GBI_F3DJFG {
+        void setup(GBI *gbi);
+    };
+};
diff --git a/src/hle/rt64_interpreter.cpp b/src/hle/rt64_interpreter.cpp
index dccaa87..343a2b9 100644
--- a/src/hle/rt64_interpreter.cpp
+++ b/src/hle/rt64_interpreter.cpp
@@ -166,6 +166,7 @@ namespace RT64 {
         state->checkRDRAM();
 
         // Run the command interpreter.
+        state->rsp->dkr.dlCount = 0;
         DisplayList *dl = dlStart;
         uint8_t opCode;
         GBIFunction func;
@@ -190,6 +191,11 @@ namespace RT64 {
                 }
             }
 
+            // Counted display lists (Rare's DMA_DL) return to their caller after a fixed number of commands.
+            if ((dl != nullptr) && (state->rsp->dkr.dlCount > 0) && (--state->rsp->dkr.dlCount == 0)) {
+                dl = state->popReturnAddress();
+            }
+
             if (dl != nullptr) {
